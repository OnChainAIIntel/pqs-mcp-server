{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.OnChainAIIntel/pqs-mcp-server",
  "description": "Score prompt quality across 8 dimensions before they reach a model. Pre-flight, not post-hoc.",
  "repository": {
    "url": "https://github.com/OnChainAIIntel/pqs-mcp-server",
    "source": "github"
  },
  "version": "1.1.0",
  "websiteUrl": "https://promptqualityscore.com",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "pqs-mcp-server",
      "version": "1.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "PQS_API_KEY",
          "description": "Your PQS API key (PQS_xxx). Get one free at promptqualityscore.com.",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://promptqualityscore.com/api/mcp"
    }
  ]
}